    <Mask>
      <Type>Motor</Type>
      <Display IconOpaque="transparent" IconRotate="port"/>
      <Description>The external and efficiency characteristics are needed. When the speed of the motor is too low or too high, it will work at its lowest or highest speed. The influence between voltage and torque is considered.</Description>
      <MaskParameter Name="nm_map" Type="edit">
        <Prompt>motor speed map (r/min)</Prompt>
        <Value>nB_map</Value>
      </MaskParameter>
      <MaskParameter Name="Tm_max_map" Type="edit">
        <Prompt>motor max torque map (Nm)</Prompt>
        <Value>TB_max_map*1.5</Value>
      </MaskParameter>
      <MaskParameter Name="Tm_min_map" Type="edit">
        <Prompt>motor min torque map  (Nm)</Prompt>
        <Value>TB_min_map*1.5</Value>
      </MaskParameter>
      <MaskParameter Name="Tmf" Type="edit">
        <Prompt>frictional resistance   (Nm)</Prompt>
        <Value>TBf</Value>
      </MaskParameter>
      <MaskParameter Name="Jm" Type="edit">
        <Prompt>rotational inertia (km/m^2)</Prompt>
        <Value>JB</Value>
      </MaskParameter>
      <MaskParameter Name="n_motor" Type="edit">
        <Prompt>motor speed (r/min)</Prompt>
        <Value>n_motor</Value>
      </MaskParameter>
      <MaskParameter Name="T_motor" Type="edit">
        <Prompt>motor torque (Nm)</Prompt>
        <Value>T_motor</Value>
      </MaskParameter>
      <MaskParameter Name="eff_motor" Type="edit">
        <Prompt>motor efficiency</Prompt>
        <Value>eff_motor</Value>
      </MaskParameter>
      <MaskParameter Name="n_generator" Type="edit">
        <Prompt>generator speed (r/min)</Prompt>
        <Value>n_generator</Value>
      </MaskParameter>
      <MaskParameter Name="T_generator" Type="edit">
        <Prompt>generator torque  (Nm)</Prompt>
        <Value>T_generator</Value>
      </MaskParameter>
      <MaskParameter Name="eff_generator" Type="edit">
        <Prompt>generator efficiency</Prompt>
        <Value>eff_generator</Value>
      </MaskParameter>
      <MaskParameter Name="T" Type="edit">
