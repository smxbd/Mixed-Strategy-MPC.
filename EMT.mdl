<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[-7, -7, 1287, 727]</P>
  <Block BlockType="From" Name="From3" SID="1298">
    <P Name="Position">[35, 33, 110, 57]</P>
    <P Name="ZOrder">-1</P>
    <P Name="BackgroundColor">green</P>
    <P Name="ShowName">off</P>
    <P Name="CloseFcn">tagdialog Close</P>
    <P Name="GotoTag">TA_com</P>
    <P Name="TagVisibility">global</P>
  </Block>
  <Block BlockType="SubSystem" Name="Motor" SID="1303">
    <PortCounts in="1" out="4" lconn="2" rconn="1"/>
    <P Name="Position">[135, 19, 340, 161]</P>
    <P Name="ZOrder">-2</P>
    <Mask>
      <Type>Motor</Type>
      <Display IconOpaque="transparent" IconRotate="port"/>
      <Description>The external and efficiency characteristics are needed. When the speed of the motor is too low or too high, it will work at its lowest or highest speed. The influence between voltage and torque is considered.</Description>
      <MaskParameter Name="nm_map" Type="edit">
        <Prompt>motor speed map (r/min)</Prompt>
        <Value>nA_map</Value>
      </MaskParameter>
      <MaskParameter Name="Tm_max_map" Type="edit">
        <Prompt>motor max torque map (Nm)</Prompt>
        <Value>TA_max_map*1.5</Value>
      </MaskParameter>
      <MaskParameter Name="Tm_min_map" Type="edit">
        <Prompt>motor min torque map  (Nm)</Prompt>
        <Value>TA_min_map*1.5</Value>
      </MaskParameter>
      <MaskParameter Name="Tmf" Type="edit">
        <Prompt>frictional resistance   (Nm)</Prompt>
